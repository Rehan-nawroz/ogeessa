# Ogeessa configuration template.
# Copy this file to `.env` (same folder) and fill in your key, or simply run
# `python main.py` once and let the setup wizard create `.env` for you.
#
# NOTE: `.env` is gitignored — never commit your real keys.

# Which provider to use: openai | anthropic | groq | gemini | ollama | custom
LLM_PROVIDER=gemini

# The key for the provider you selected (only that one is read).
GEMINI_API_KEY=your_key_here

# --- optional: other providers' keys (switch with /config inside the TUI) ---
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here

# --- optional: model overrides ---
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=llama3

# --- optional: custom OpenAI-compatible endpoint (LLM_PROVIDER=custom) ---
# CUSTOM_PROVIDER_NAME=My local model
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=not-needed-for-local
# CUSTOM_MODEL=my-model

# --- optional: enriches the earnings / economic calendar ---
# FINNHUB_API_KEY=